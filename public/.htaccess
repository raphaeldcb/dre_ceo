<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set the base path
    RewriteBase /dre_ceo/

    # Don't rewrite if the file or directory exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rewrite all requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
